<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SintomasDoencas.Cadastro"
             xmlns:local="clr-namespace:SintomasDoencas"
             BackgroundColor="White"
             Title="Cadastro de Usuário">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Roboto"/>
        </Style>
        
    </ContentPage.Resources>
    
    <ScrollView VerticalOptions="FillAndExpand">
        <StackLayout
        Padding="30,0,30,0"
        Spacing="25"
        VerticalOptions="Center">

            <Label Text="Cadastro"
                   Margin="0,0,0,5"
                   FontSize="28"
                   TextColor="black"
                   FontAttributes="Bold"/>

            <Label
                HorizontalOptions="Start"
                Text="Usuário"
                Margin="0,0,0,5"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Black" />
            
            <Frame 
                Padding="0"
                Margin="5,0,0,0"
                BackgroundColor="White"
                BorderColor="Black"
                CornerRadius="15"
                HasShadow="True"
                HeightRequest="58"
                HorizontalOptions="FillAndExpand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <local:BorderlessEntry
                            x:Name="Usuario"    
                            Margin="10,0,10,0"
                            HorizontalOptions="FillAndExpand"
                            Placeholder="Digite seu usuário"
                            VerticalOptions="Center" 
                            TextColor="black"
                            PlaceholderColor="#c1c5ce"    
                            FontFamily="Roboto"
                            Grid.Column="0"/>

                        <Image 
                            Margin="0,0,12,0"
                            Source="usuario.png" 
                            Aspect="AspectFit" 
                            WidthRequest="30"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Grid.Column="1"/>   
                     </Grid>
            </Frame>
            
            
            <Label
                Margin="0,15,0,5"
                HorizontalOptions="Start"
                Text="Senha"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Black" />

            <Frame
                Padding="0"
                Margin="5,0,0,0"
                BackgroundColor="White"
                BorderColor="Black"
                CornerRadius="15"
                HasShadow="True"
                HeightRequest="58"
                HorizontalOptions="FillAndExpand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <local:BorderlessEntry
                                            x:Name="Senha"
                                            Margin="10,0,10,0"
                                            IsPassword="True"
                                            Placeholder="Senha"
                                            HorizontalOptions="FillAndExpand"
                                            TextColor="#6E7994"
                                            PlaceholderColor="#c1c5ce"
                                            VerticalOptions="Center"
                                            FontFamily="Roboto"/>

                                <ImageButton 
                                            x:Name="VerSenha"
                                            Margin="0,0,12,0"
                                            Source="olhofechado.png" 
                                            Aspect="AspectFit" 
                                            WidthRequest="30"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            Clicked="VerSenha_Clicked"
                                            Grid.Column="1"/>
                            </Grid>
             </Frame>

             <Button
                x:Name="cadastro"
                Margin="5,40,-5,0"
                BackgroundColor="#0265ff"
                Clicked="Button_Clicked"
                CornerRadius="15"
                HeightRequest="60"
                HorizontalOptions="Fill"
                Text="Cadastrar"
                FontAttributes="Bold"
                TextColor="White" />



        </StackLayout>
    </ScrollView>

</ContentPage>
