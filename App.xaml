<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SintomasDoencas"
             x:Class="SintomasDoencas.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Define o estilo para a NavigationPage -->
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="#3498db" />
                <!-- Cor de fundo da barra de navegação -->
                <Setter Property="BarTextColor" Value="White" />
                <!-- Cor do texto da barra de navegação -->
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
  
</Application>
