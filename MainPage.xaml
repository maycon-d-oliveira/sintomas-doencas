<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SintomasDoencas.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SintomasDoencas"
    BackgroundColor="White">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Roboto"/>
        </Style>
    </ContentPage.Resources>
    <ScrollView VerticalOptions="FillAndExpand">
        <StackLayout
            Padding="30,0,30,0"
            Spacing="25"
            VerticalOptions="Center">
            <StackLayout>
                <Image Source="login.svg" Aspect="AspectFit" WidthRequest="250"/>
                <Label Text="Login"
                       Margin="0,0,0,5"
                       FontSize="28"
                       TextColor="black"
                       FontAttributes="Bold"/>
                
                <Label Text="Faça Login para continuar a usar o App:"
                       Margin="0,0,0,30"
                       TextColor="#c1c5ce"
                       />
                <Label
                    HorizontalOptions="Start"
                    Text="Usuário"
                    Margin="0,0,0,5"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="Black" />

                <Frame 
                    Padding="0"
                    Margin="5,0,0,0"
                    BackgroundColor="White"
                    BorderColor="Black"
                    CornerRadius="15"
                    HasShadow="True"
                    HeightRequest="58"
                    HorizontalOptions="FillAndExpand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <local:BorderlessEntry
                            x:Name="Usuario"    
                            Margin="10,0,10,0"
                            HorizontalOptions="FillAndExpand"
                            Placeholder="Digite seu usuário"
                            VerticalOptions="Center" 
                            TextColor="black"
                            PlaceholderColor="#c1c5ce"    
                            FontFamily="Roboto"
                            Grid.Column="0"/>

                        <Image 
                            Margin="0,0,12,0"
                            Source="usuario.png" 
                            Aspect="AspectFit" 
                            WidthRequest="30"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Grid.Column="1"/>
                    </Grid>
                </Frame>
                <Label
                    Margin="0,15,0,5"
                    HorizontalOptions="Start"
                    Text="Senha"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="Black" />

                <Frame
                    Padding="0"
                    Margin="5,0,0,0"
                    BackgroundColor="White"
                    BorderColor="Black"
                    CornerRadius="15"
                    HasShadow="True"
                    HeightRequest="58"
                    HorizontalOptions="FillAndExpand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <local:BorderlessEntry
                                x:Name="Senha"
                                Margin="10,0,10,0"
                                IsPassword="True"
                                Placeholder="Senha"
                                HorizontalOptions="FillAndExpand"
                                TextColor="#6E7994"
                                PlaceholderColor="#c1c5ce"
                                VerticalOptions="Center"
                                FontFamily="Roboto"/>

                        <ImageButton 
                                x:Name="VerSenha"
                                Margin="0,0,12,0"
                                Source="olhofechado.png" 
                                Aspect="AspectFit" 
                                WidthRequest="30"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent"
                                Clicked="VerSenha_Clicked"
                                Grid.Column="1"/>
                    </Grid>
                </Frame>

                <Button
                    x:Name="login"
                    Margin="5,40,-5,0"
                    BackgroundColor="#0265ff"
                    Clicked="login_Clicked"
                    CornerRadius="15"
                    HeightRequest="60"
                    HorizontalOptions="Fill"
                    Text="Entrar"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="1"
                        Margin="0,15,0,0"
                        HorizontalOptions="Start"
                        TextColor="Black"
                        Text="Não tem uma conta? " />

                    <Label
                        Grid.Column="1"
                        Margin="0,15,0,0"
                        HorizontalOptions="End"
                        Text="Cadastrar"
                        TextColor="#0265ff">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </StackLayout>
        </StackLayout>
    </ScrollView>

</ContentPage>
